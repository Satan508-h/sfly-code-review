diff --git a/app/paging.py b/app/paging.py
--- /dev/null
+++ b/app/paging.py
@@ -0,0 +1,25 @@
+"""分页参数的解析与收敛。"""
+from __future__ import annotations
+
+from typing import Final
+
+DEFAULT_PAGE_SIZE: Final = 20
+MAX_PAGE_SIZE: Final = 100
+
+
+def parse_offset(raw: str) -> int:
+    """负数与非数字都收敛到 0。"""
+    try:
+        value = int(raw)
+    except ValueError:
+        return 0
+    return max(0, value)
+
+
+def parse_limit(raw: str) -> int:
+    """限制在 [1, MAX_PAGE_SIZE]。"""
+    try:
+        value = int(raw)
+    except ValueError:
+        return DEFAULT_PAGE_SIZE
+    return min(max(1, value), MAX_PAGE_SIZE)
