+TIMEOUT_S = 10.0
+
+
+def charge(order_id: str, amount_cents: int) -> dict:
+    payload = {"order": order_id, "amount": amount_cents}
+    response = httpx.post(
+        "https://billing.internal/v1/charge",
+        json=payload,
+        headers={"Authorization": BILLING_API_KEY},
+        timeout=TIMEOUT_S,
+    )
+    return response.json()
