diff --git a/static/comment.js b/static/comment.js
--- /dev/null
+++ b/static/comment.js
@@ -0,0 +1,18 @@
+// 评论区渲染。
+
+const MAX_LEN = 2000;
+
+export function renderComment(container, comment) {
+  const body = comment.body.slice(0, MAX_LEN);
+  container.innerHTML = `<p class="author">${comment.author}</p><p>${body}</p>`;
+}
+
+export function clear(container) {
+  container.textContent = "";
+}
