# 复制成 .env 即可：cp .env.example .env
#
# **默认值全部留空也能跑通全链路**（Mock LLM + 本地 Docker 的 Postgres/Redis）。
# 下面的每一组都是「想用真实服务时才打开」。
#
# 注意：DATABASE_URL / REDIS_URL 在 docker compose 里由 compose 直接注入
# （容器内主机名是 postgres / redis，不是 localhost）。这个文件里的值只在
# **宿主机**上跑脚本时生效，比如 `uv run python -m sfly_workers --diff ...`。

# =========================================================================== #
# 运行模式
# =========================================================================== #

# full = 7 容器分布式（默认）；lite = 单容器（Render 用）
MODE=full
LOG_LEVEL=INFO
# 本地调试想读彩色日志就设 false
LOG_JSON=true

# =========================================================================== #
# 宿主机端口映射
#
# 本机已经有 Postgres / Redis 时（比如另一个项目在跑），默认端口会冲突，
# 报错是 "Bind for 127.0.0.1:6379 failed: port is already allocated" ——
# 它不会告诉你谁占的。改成空闲端口即可。
#
# 改了之后**记得同步下面的 DATABASE_URL / REDIS_URL**。
#
# 容器之间是用服务名互访的（postgres:5432、redis:6379），走的 Docker 内网，
# 所以这两个映射**只影响你从宿主机连进去调试**，对应用本身零影响。
# =========================================================================== #

POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# =========================================================================== #
# 存储（宿主机跑脚本时用；容器内由 compose 覆盖）
# =========================================================================== #

# 注意是 psycopg v3 的连接串。不要写成 postgresql+asyncpg://
DATABASE_URL=postgresql://sfly:sfly@localhost:5432/sfly
REDIS_URL=redis://localhost:6379/0

# Neon 免费版会主动掐空闲连接，池子必须开 check_connection（代码里已处理）。
# 免费版并发上限很低，别调大。
DB_POOL_MIN=1
DB_POOL_MAX=5

# libpq 的连接超时。默认 0 是「交给操作系统」，某些网络下会挂起数分钟。
DB_CONNECT_TIMEOUT_S=10
# /api/health 探测 Postgres 的等待上限。它直接决定「数据库挂了的时候健康页有多慢」——
# 数据库不可达时这个等待会走满。调小响应更快，但库只是「慢」时会误报 DOWN。
DB_PING_TIMEOUT_S=5.0

# =========================================================================== #
# 传输后端 —— 只有 sfly_bus/factory.py 允许拿这两个值做分支
# =========================================================================== #
#
# redis  → RedisStreamsQueue / RedisLock：完整模式，可 --scale，需要 redis 容器
# memory → InMemoryQueue / InMemoryLock：精简模式，单进程 asyncio，不需要 Redis
#
# **两个要一起改。** 混搭（比如队列用 memory、锁用 redis）不会报错，
# 但要么跨副本互斥失效、要么根本没有 Redis 可连 —— 所以 factory 会打一条
# config.backend_mismatch 警告。除非你确实知道为什么，否则保持一致。
QUEUE_BACKEND=redis
LOCK_BACKEND=redis

# =========================================================================== #
# 队列行为
# =========================================================================== #

# XAUTOCLAIM 的空闲阈值。低于 60s 会偷走在跑的活；高于 300s 恢复变慢。
# 回收早了只是浪费 token（重复结果被数据库主键吸收），不产出错数据。
CLAIM_IDLE_MS=180000
RECLAIM_INTERVAL_S=30
# 重试上限：投递次数**达到**这个值还没成功就进死信（attempt 从 1 开始，所以 3 = 三次机会）。
# 队列负责把次数数准（INCR sfly:attempts:*），**判定点在 Worker** —— 它同时要做两件事：
# 先补一条 failed 结果闭合屏障，再把消息送进死信。前者是正确性，后者只是运维可见性。
# 不可重试的错误（schema_unrecoverable / diff_too_large / repo_not_found / auth_revoked）
# 不看这个值，第一次就进死信。
MAX_ATTEMPTS=3

# =========================================================================== #
# 编排
# =========================================================================== #

# interrupt = LangGraph 的 interrupt()，图暂停期间崩溃也能从 checkpoint 恢复
# poll      = 20 行的轮询循环，土但绝对能跑
# M5 卡住超过一天就切 poll —— 先跑通优于先优雅
WAIT_STRATEGY=interrupt

RUN_DEADLINE_S=600
SWEEPER_INTERVAL_S=15

# rules = 确定性规则引擎（评测可复现，默认）
# llm   = 让 LLM 裁决（M11 的 A/B 对照，会让评测结果不可复现）
CONFLICT_RESOLVER=rules

# =========================================================================== #
# 审查规模与预算
# =========================================================================== #

PR_MAX_FILES=40
PR_MAX_PATCH_CHARS=200000
PER_FILE_PATCH_CHARS=8000
# 单个 run 的 token 上限，超过后以 status=partial 收尾而非失败
RUN_TOKEN_BUDGET=200000
WORKER_CONCURRENCY=4

# =========================================================================== #
# LLM
# =========================================================================== #

# mock | deepseek | openai
# 保持 mock 的话不需要任何密钥；换成 deepseek 才会真正调 API
LLM_PROVIDER=mock

# DeepSeek 的 key，形如 sk-xxxxxxxx
LLM_API_KEY=

# 留空则用 provider 的默认地址：
#   deepseek -> https://api.deepseek.com
#   openai   -> https://api.openai.com/v1
# 走的是 OpenAI 兼容接口，所以换成 vLLM / 本地模型只要改这个地址
LLM_BASE_URL=
# 留空则用默认模型：deepseek-flash / gpt-4o-mini
#
# 注意：模型 id 是有保质期的，厂商随时可能改名或下线它。
# DeepSeek 把 deepseek-chat 用在了一个 2026-07-24 就停用的别名上，
# 继续用它发请求会直接 400。换 provider 或隔一段时间之后，
# 先跑这条命令确认当前有效的 id，再把它填到这里：
#   curl https://api.deepseek.com/models -H "Authorization: Bearer $LLM_API_KEY"
# 完整的模型名以那次返回为准，不要照抄上面那个默认值。
LLM_MODEL=

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_CONNECT_TIMEOUT_S=10
LLM_READ_TIMEOUT_S=120
# 修复阶梯里 L3 的调用次数，超过 1 次就是纯粹烧钱
LLM_MAX_REPAIRS=1

# =========================================================================== #
# Mock LLM —— 离线开发时用来**故意制造故障**
# =========================================================================== #

# 设 0.3 让 Mock 吐出带围栏 / 截断 / 裸标识符的响应，
# 验证修复阶梯和逐元素校验真的在工作，而不是纸面上存在
MOCK_LLM_FAILURE_RATE=0
# 设 200000 模拟卡死的 Worker，配合调小 RUN_DEADLINE_S 验证超时兜底
MOCK_LLM_DELAY_MS=0

# LLM 故障时降级到 Mock。**只允许开发环境开** —— 开到线上就是静默造假
ALLOW_MOCK_FALLBACK=false

# =========================================================================== #
# 线上限流（lite 模式，公网链接防刷）
# =========================================================================== #

# 设 false 则线上永远走 Mock，一分钱不花
ENABLE_REAL_LLM=true
# 访客要带上这个 key 才能触发真实 LLM 审查。留空表示不限制。
# 公网演示时**务必设一个**，否则任何人点一下都在花你的钱。
DEMO_ACCESS_KEY=

RATE_LIMIT_PER_IP_PER_HOUR=3
DAILY_LLM_CALL_BUDGET=200
# 超过预算自动降级为 Mock 而不是报错 —— 访客仍然看到完整流程
DAILY_LLM_COST_BUDGET_USD=2.0

# =========================================================================== #
# GitHub
# =========================================================================== #

# 留空 = dry-run：审查照跑、报告照出，只是不发评论（事件里 posted=false）。
# 真实发布需要 pull_requests:write + issues:write（或经典 token 的 repo 权限）
GITHUB_TOKEN=
# 在仓库 Settings → Webhooks 里设置的那个字符串，用于校验 X-Hub-Signature-256
GITHUB_WEBHOOK_SECRET=

# 从第一天就可配。指向 tests/github_stub.py 是 publish 节点能被单测的前提，
# 也是手工演示「限流后退避重试」的开关：
#   python tests/github_stub.py --port 8099      # 前 2 次发布返回 429
#   GITHUB_API_BASE=http://host.docker.internal:8099
GITHUB_API_BASE=https://api.github.com
GITHUB_MAX_RETRIES=3
# 单次限流等待的上限；超过就直接判 publish_failed（报告还在，够重新发布）
GITHUB_MAX_WAIT_S=60

# =========================================================================== #
# 可观测性
# =========================================================================== #

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =========================================================================== #
# HTTP / CORS
# =========================================================================== #

# 完整模式下 nginx 同源代理，用不上 CORS。
# **精简模式下前端在 Vercel，必须列出来**，否则浏览器拦截 SSE 请求。
# 逗号分隔，例如：https://sfly.vercel.app,https://sfly-git-main.vercel.app
CORS_ORIGINS=http://localhost:5173

# Render 动态分配端口，必须从环境变量读，写死会得到 502
PORT=8000
